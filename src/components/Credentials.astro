---
import { profile } from '../data/profile';
const groups = [
  { title: '학력 · 교육', items: profile.education },
  { title: '자격증', items: profile.certifications },
  { title: '수상', items: profile.awards },
].filter(group => group.items?.length);
---

{groups.length > 0 && <section id="credentials" class="section" aria-labelledby="credentials-title">
  <div class="container">
    <p class="eyebrow">BACKGROUND</p>
    <h2 id="credentials-title" class="section-title">학력 및 자격</h2>
    <div class="credentials-grid">{groups.map(group => <div class="group"><h3>{group.title}</h3><ul>{group.items?.map(item => <li>
      {!item.date.trimStart().startsWith('TODO') && <span class="date">{item.date}</span>}
      <p class="title">{item.title}</p>{item.issuer && <p class="issuer">{item.issuer}</p>}
    </li>)}</ul></div>)}</div>
  </div>
</section>}

<style>
  .eyebrow { margin: 0 0 calc(var(--gutter) / 2); font: .75rem var(--font-mono); color: var(--accent); letter-spacing: .06em; }
  .credentials-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: calc(var(--gutter) * 2); }
  .group { border-top: 1px solid var(--border); padding-top: var(--gutter); min-width: 0; }
  h3 { margin: 0 0 var(--gutter); font-size: .95rem; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: calc(var(--gutter) * 1.25); }
  li { overflow-wrap: anywhere; }
  .date { color: var(--text-muted); font: .7rem/1.7 var(--font-mono); }
  .title { margin: calc(var(--gutter) / 4) 0 0; font-size: .85rem; }
  .issuer { margin: calc(var(--gutter) / 4) 0 0; color: var(--text-muted); font-size: .8rem; }
  @media (max-width: 650px) { .credentials-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
