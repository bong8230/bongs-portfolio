---
import { profile } from '../data/profile';
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="container about-grid">
    <div><p class="eyebrow">01 / ABOUT</p><h2 id="about-title" class="section-title">소개</h2></div>
    <div class="copy">{profile.about.map(paragraph => <p>{paragraph}</p>)}</div>
  </div>
</section>

<style>
  .about-grid { display: grid; grid-template-columns: 1fr 3fr; gap: calc(var(--gutter) * 2); }
  .eyebrow { margin: 0 0 calc(var(--gutter) / 2); font: .75rem var(--font-mono); color: var(--accent); letter-spacing: .06em; }
  .copy { min-width: 0; }
  .copy p { margin: 0 0 var(--gutter); color: var(--text-muted); word-break: keep-all; overflow-wrap: anywhere; }
  .copy p:first-child { color: var(--text); }
  .copy p:last-child { margin-bottom: 0; }
  @media (max-width: 600px) { .about-grid { grid-template-columns: minmax(0, 1fr); gap: 0; } }
</style>
