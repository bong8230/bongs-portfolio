---
import { profile } from '../data/profile';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <p class="eyebrow">{profile.title}</p>
    <h1 id="hero-title">안녕하세요,<br /><span>{profile.name}</span>입니다.</h1>
    <p class="tagline">{profile.tagline}</p>
    <div class="actions">
      <a class="primary" href="#projects">프로젝트 보기 <span aria-hidden="true">↗</span></a>
      <a class="secondary" href="#contact">연락하기 <span aria-hidden="true">→</span></a>
    </div>
    {profile.links?.length > 0 && <div class="links">{profile.links.map(link => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span><span class="sr-only"> (새 탭)</span></a>)}</div>}
  </div>
</section>

<style>
  .hero { padding-block: var(--section-gap); border-bottom: 1px solid var(--border); }
  .eyebrow { margin: 0 0 var(--gutter); color: var(--accent); font: 700 .875rem var(--font-sans); letter-spacing: .08em; }
  h1 { margin: 0; font-size: clamp(2.6rem, 7vw, 4.5rem); line-height: 1.2; letter-spacing: -.065em; overflow-wrap: anywhere; }
  h1 span { color: var(--accent); }
  .tagline { max-width: 38rem; margin: calc(var(--gutter) * 1.5) 0 0; color: var(--text-muted); font-size: clamp(1rem, 2vw, 1.2rem); word-break: keep-all; overflow-wrap: anywhere; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--gutter); margin-top: calc(var(--gutter) * 2); }
  .actions a { display: inline-flex; align-items: center; gap: var(--gutter); padding: calc(var(--gutter) * .75) calc(var(--gutter) * 1.25); border-radius: var(--radius); font-size: .9rem; font-weight: 600; }
  .primary { background: var(--accent); color: var(--bg); }
  .secondary { border: 1px solid var(--border); color: var(--text); background: var(--surface); }
  .links { display: flex; flex-wrap: wrap; gap: var(--gutter); margin-top: calc(var(--gutter) * 1.5); font-size: .85rem; }
  .links a { color: var(--text-muted); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 600px) { .hero { padding-block: calc(var(--section-gap) * .7); } }
</style>
