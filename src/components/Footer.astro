---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer><div class="container footer-inner"><p>© {year} {profile.name}</p><p>{profile.title}</p><a href="#">맨 위로 <span aria-hidden="true">↑</span></a></div></footer>

<style>
  footer { border-top: 1px solid var(--border); padding-block: calc(var(--gutter) * 1.5); margin-top: calc(var(--section-gap) / 2); }
  .footer-inner { display: flex; align-items: center; flex-wrap: wrap; gap: calc(var(--gutter) / 2) var(--gutter); color: var(--text-muted); font-size: .75rem; overflow-wrap: anywhere; }
  p { margin: 0; }
  a { margin-left: auto; color: var(--text-muted); }
  @media (max-width: 450px) { .footer-inner p:nth-child(2) { display: none; } }
</style>
